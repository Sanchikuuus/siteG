---
import background from '../assets/background.svg';
import { sitePath } from '../utils/paths';
import { ClientRouter, fade } from 'astro:transitions';

interface Props {
    title?: string;
    description?: string;
}
const { title = 'Test Page' } = Astro.props;
const links = [
    {href: '/', label: 'Головна'},
    {href: '/about', label: 'Про нас'},
    {href: '/products', label: 'Продукти'},
    {href: '/news', label: 'Новини'},
    {href: '/contacts', label: 'Контакти'},
    {href: '/feedback', label: 'Зворотний зв’язок'},
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="uk" transition:animate="none">
<head>
    <meta charset="utf-8"/>
    <title>{title} | Test Page</title>
    <ClientRouter fallback="animate" />
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <link rel="icon" type="image/svg+xml" href={`${sitePath()}favicon.svg`}/>
    <link rel="icon" href={`${sitePath()}favicon.ico`}/>
    <meta name="generator" content={Astro.generator}/>
</head>
<body>
<a class="skip-link" href="#content">Перейти до вмісту</a>
<!-- Зберігаємо той самий фон під час переходів між сторінками. -->
<img id="background" src={background.src} alt="" fetchpriority="high" transition:persist="site-background" />
<header class="container site-header">
    <a class="brand" href={sitePath()}>Test Page</a>
    <nav aria-label="Основна навігація">
        {links.map(({href, label}) => (
                <a href={sitePath(href)} aria-current={currentPath === (sitePath(href).replace(/\/$/, '') || '/') ? 'page' : undefined}>{label}</a>
        ))}
    </nav>
</header>
<main id="content" class="container" transition:name="page-content" transition:animate={fade({ duration: '250ms' })}>
    <slot/>
</main>
<footer class="container site-footer">© {new Date().getFullYear()} Test Page</footer>
</body>
</html>

<style is:global>
    * {
        box-sizing: border-box;
    }

	#background {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: -1;
		filter: blur(100px);
	}

    html {
        background-color: #f8f5fc;
    }

    body {
        isolation: isolate;
        min-height: 100vh;
        margin: 0;
        font-family: system-ui, sans-serif;
        line-height: 1.6;
    }

    .container {
        width: min(100% - 2rem, 1000px);
        margin-inline: auto;
    }

    .site-header {
        padding-block: 1.5rem;
        border-bottom: 1px solid #dce2eb;
    }

    .brand {
        font-size: 1.25rem;
        font-weight: 750;
        text-decoration: none;
    }

    nav {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem 1.25rem;
        margin-top: 1rem;
    }

    nav a {
        text-decoration: none;
    }

    nav a[aria-current="page"] {
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: .3rem;
    }

    a {
        color: #2458a6;
    }

    main {
        min-height: 60vh;
        padding-block: 3rem;
    }

    h1 {
        font-size: clamp(2rem, 5vw, 3rem);
        line-height: 1.2;
        margin: 0 0 1rem;
    }

    h2 {
        font-size: 1.25rem;
        margin-top: 0;
    }

    p {
        margin: 0 0 1rem;
    }

    .intro {
        max-width: 65ch;
        color: #536176;
        margin-bottom: 2rem;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
        gap: 1rem;
    }

    .card {
        padding: 1.5rem;
        background: #fff;
        border: 1px solid #dce2eb;
        border-radius: .75rem;
    }

    .card p:last-child {
        margin-bottom: 0;
    }

    .button {
        display: inline-block;
        padding: .7rem 1.1rem;
        border: 0;
        border-radius: .4rem;
        background: #2458a6;
        color: white;
        font: inherit;
        text-decoration: none;
        cursor: pointer;
    }

    .button:hover {
        background: #194580;
    }

    .site-footer {
        padding-block: 1.5rem;
        border-top: 1px solid #dce2eb;
        color: #536176;
    }

    :focus-visible {
        outline: 3px solid #2458a6;
        outline-offset: 4px;
    }

    .skip-link {
        position: absolute;
        top: -100px;
        left: 1rem;
        padding: .5rem;
        background: white;
    }

    .skip-link:focus {
        top: 1rem;
    }
</style>
