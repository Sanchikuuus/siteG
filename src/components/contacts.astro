---
// Демонстраційні контакти — замініть їх перед публікацією.
const contacts = {
	email: 'hello@example.com',
	phone: '+380 00 000 00 00',
	address: 'Гараж 151',
	hours: 'Сб–Нд, 09:00–21:00',
};
---

<section aria-labelledby="contacts-title">
	<h1 id="contacts-title">Контакти</h1>
	<p class="intro">Зв’яжіться з нами зручним для вас способом.</p>
	<div class="card">
		<address>
			<p><strong>Email:</strong> <a href={`mailto:${contacts.email}`}>{contacts.email}</a></p>
			<p><strong>Телефон:</strong> <a href={`tel:${contacts.phone.replace(/\s/g, '')}`}>{contacts.phone}</a></p>
			<p><strong>Адреса:</strong> {contacts.address}</p>
		</address>
		<p><strong>Години роботи:</strong> {contacts.hours}</p>
	</div>
</section>

<style>
	address { font-style: normal; }
</style>
